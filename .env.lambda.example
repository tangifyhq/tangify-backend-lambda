# Copy to .env.lambda (gitignored) and fill in values, then run:
#   ./scripts/sync-lambda-env.sh
#
# Required for review generation:
LLM_API_KEY=
#
# Required for menu + review dish names:
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=
# Web ordering publish uses this tab (defaults to ordering_app_menu if unset):
# GOOGLE_ORDERING_SHEET_NAME=ordering_app_menu
#
# Web ordering menu publish (POST /api/v1/web/menu/publish → R2):
# Use the files.tangify.in R2 bucket (not order-history backups).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_MENU_KEY=menu/v1.json
WEB_MENU_PUBLIC_BASE_URL=https://files.tangify.in
# Public origin used in WhatsApp login reply links:
WEB_ORDER_PUBLIC_BASE_URL=https://order.tangify.in
# Optional — purge CDN cache after publish:
# CF_API_TOKEN=
# CF_ZONE_ID=
#
# Optional:
TANGIFY_BOOTSTRAP_SECRET=
TANGIFY_VENUE_ID=
CF_SECRET=
ABLY_KEY=
# Prod order_ops channel (default in code). Prod webapp + hub .env use order_ops.
ABLY_CHANNEL=order_ops
# While prod Lambda also serves dev testing: duplicate loyalty:wa-link to dev channel.
# Omit in pure-prod deploy (restaurant-only, no local dev listeners).
ABLY_CHANNEL_DEV=order_ops_dev
#
# Invoice number workers (Cloudflare):
INVOICE_NUMBER_WORKER_URL_PROD=https://invoice-number-cf-worker.subnub.workers.dev/
INVOICE_NUMBER_WORKER_URL_DEV=https://invoice-number-cf-worker-dev.subnub.workers.dev/
# Web order number workers (Cloudflare):
WEB_ORDER_NUMBER_WORKER_URL_PROD=https://tangify-web-order-number-generator.subnub.workers.dev/
WEB_ORDER_NUMBER_WORKER_URL_DEV=https://tangify-web-order-number-generator-dev.subnub.workers.dev/
#
# WhatsApp (Gupshup). API key / source / app name live in env.
# Template UUIDs default in api/gupshup_templates.go; set these to override.
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=
GUPSHUP_REWARD_POINT_TEMPLATE_ID=
GUPSHUP_POINTS_USED_TEMPLATE_ID=
GUPSHUP_OTP_TEMPLATE_ID=
#
# Web ordering payments (Razorpay). Secret stays on Lambda only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Web ordering delivery quotes (Shiprocket hyperlocal serviceability).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=562125
SHIPROCKET_PICKUP_LAT=12.8616
SHIPROCKET_PICKUP_LNG=77.786
# Optional weight used for quotes (kg):
# SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
